Project Verbarium {
  database_type: 'PostgreSQL'
  Note: '''
  Canonical source of truth for Verbarium's evolving relational data model.

  Model only durable decisions here. Hylia records the reasoning behind them.
  The passage schema is intentionally being introduced incrementally.

  `identifier` is a conceptual placeholder type. The concrete PostgreSQL
  identifier strategy has not been decided yet.

  `token_sequence` is a conceptual placeholder type. The physical storage
  representation for ordered tokens has not been decided yet. Token sequences
  are lossless for textual content and do not encode editorial line breaks.
  '''
}

Table Work {
  id identifier [pk]
  title text [not null]

  Note: 'Identity of an identifiable underlying textual work. A Work is optional within Provenance because not every textual origin is a work.'
}

Table Provenance {
  id identifier [pk]
  work_id identifier [ref: > Work.id]
  title text [not null]
  publication_year int

  Note: 'Broader origin or source context for textual material. It may reference an identifiable Work, but can also stand independently for origins such as a popular saying or oral tradition. title and publication_year are existing structured provenance fields whose precise applicability will continue to be refined incrementally.'
}

Table Passage {
  id identifier [pk]
  provenance_id identifier [not null, ref: > Provenance.id]

  Note: 'Bounded passage-level identity within a Provenance. Attestations and translations are concrete textual renderings of this passage.'
}

Table Attestation {
  id identifier [pk]
  passage_id identifier [not null, ref: > Passage.id]
  provenance_id identifier [not null, ref: > Provenance.id]
  tokens token_sequence [not null]
  witness_url text [not null]

  Note: 'One source-language textual form of a Passage. Its ordered tokens are the canonical lossless textual representation, including punctuation and textual whitespace but excluding editorial line breaks. Provenance identifies the shared source/resource; witness_url points directly to the specific attested text within that resource.'
}

Table Translation {
  id identifier [pk]
  passage_id identifier [not null, ref: > Passage.id]
  provenance_id identifier [ref: > Provenance.id]
  tokens token_sequence [not null]

  Note: 'One translated rendering of a Passage. Its ordered tokens are the canonical lossless textual representation, parallel to Attestation tokens. Provenance is optional so Verbarium-authored translations need not invent an external source. It does not imply a known historical Attestation basis.'
}

Table Alignment {
  attestation_id identifier [not null, ref: > Attestation.id]
  translation_id identifier [not null, ref: > Translation.id]

  Note: 'Connects one Attestation with one Translation for Verbarium alignment data. Passage identity is implied by the referenced entities rather than duplicated here.'
}
