Project Verbarium {
  database_type: 'PostgreSQL'
  Note: '''
  Design/diagram representation of Verbarium's evolving relational data model.

  Once Supabase declarative schemas are present under supabase/schemas/, those SQL
  files are the executable source of truth. Keep this DBML synchronized as a
  convenient visual/reference model. Hylia records the reasoning behind decisions.
  The passage schema is intentionally being introduced incrementally.

  Ordinary entity identifiers use PostgreSQL uuid values generated by
  gen_random_uuid(). Alignment uses its Attestation/Translation pair as a
  composite primary key instead of a separate entity id.

  Ordered token sequences and Alignment mappings/breaks are stored as jsonb.
  These payloads preserve Quote Slicer's structured data directly and are
  intentionally not normalized into separate relational child tables at this stage.
  Token sequences remain lossless for textual content and do not encode editorial
  line breaks.
  '''
}

Table Provenance {
  id uuid [pk, default: `gen_random_uuid()`]
  title text
  author text
  publication_year int

  Note: 'Umbrella origin/source identity for textual material. A record may represent an underlying work, a broader origin such as a popular saying or oral tradition, or a more specific source such as an edition, manuscript resource, publication, or website. Structured fields are optional because different provenances carry different information. author names the author of the textual object represented by this Provenance, including a translator when the Provenance represents a translation. No fixed provenance type/category is modeled yet.'
}

Table Passage {
  id uuid [pk, default: `gen_random_uuid()`]
  provenance_id uuid [not null, ref: > Provenance.id]

  Note: 'Bounded passage-level identity within a Provenance. Attestations and translations are concrete textual renderings of this passage.'
}

Table Attestation {
  id uuid [pk, default: `gen_random_uuid()`]
  passage_id uuid [not null, ref: > Passage.id]
  provenance_id uuid [not null, ref: > Provenance.id]
  tokens jsonb [not null]
  witness_url text

  Note: 'One source-language textual form of a Passage. Its ordered tokens are the canonical lossless textual representation, including punctuation and textual whitespace but excluding editorial line breaks. Provenance identifies the shared source/resource; witness_url is optional and points directly to the specific attested text within that resource when available.'
}

Table Translation {
  id uuid [pk, default: `gen_random_uuid()`]
  passage_id uuid [not null, ref: > Passage.id]
  provenance_id uuid [ref: > Provenance.id]
  tokens jsonb [not null]
  witness_url text

  Note: 'One translated rendering of a Passage. Its ordered tokens are the canonical lossless textual representation, parallel to Attestation tokens. Provenance is optional so Verbarium-authored translations need not invent an external source. witness_url is optional and points directly to this translation online when available. It does not imply a known historical Attestation basis.'
}

Table Alignment {
  attestation_id uuid [not null, ref: > Attestation.id]
  translation_id uuid [not null, ref: > Translation.id]
  mappings jsonb [not null]
  breaks jsonb [not null]

  indexes {
    (attestation_id, translation_id) [pk]
  }

  Note: 'Exactly one Alignment exists per Attestation/Translation pair, identified by the composite primary key. mappings and breaks are structured Alignment-owned payloads kept intact for faithful reconstruction rather than normalized into child tables. Passage identity is implied by the referenced entities rather than duplicated here. Multiple alternative alignments for the same pair are deferred until needed.'
}

Table auth.users {
  id uuid [pk]

  Note: 'Managed by Supabase Auth. Verbarium keeps no user table of its own; rows owned by a reader reference this.'
}

Table LessonCompletion {
  user_id uuid [not null, ref: > auth.users.id]
  lesson smallint [not null]
  completed_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, lesson) [pk]
  }

  Note: 'Records that a reader finished a lesson. Lessons are MDX documents rather than rows, so lesson is its number, 1 to 177, rather than a reference.'
}
